#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/dist/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/node_modules"
else
  export NODE_PATH="/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/dist/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/vercel@48.6.0/node_modules:/home/noct/.local/share/pnpm/global/5/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/dist/vc.js" "$@"
else
  exec node  "$basedir/global/5/.pnpm/vercel@48.6.0/node_modules/vercel/dist/vc.js" "$@"
fi
